<?php

namespace Database\Seeders;

use App\Models\User;
use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\Hash;

class CrudAdminSeeder extends Seeder
{
    public function run(): void
    {
        $roleModel = \Spatie\Permission\Models\Role::class;

        if (class_exists($roleModel)) {
            foreach (['super_admin', 'admin', 'manager', 'viewer'] as $roleName) {
                $roleModel::firstOrCreate(['name' => $roleName]);
            }
        }

        $admin = User::query()->firstOrCreate(
            ['email' => 'admin@example.com'],
            [
                'name'              => 'Super Admin',
                'password'          => Hash::make('password'),
                'email_verified_at' => now(),
            ]
        );

        if (method_exists($admin, 'syncRoles')) {
            $admin->syncRoles(['super_admin']);
        }

        $viewer = User::query()->firstOrCreate(
            ['email' => 'viewer@example.com'],
            [
                'name'              => 'Viewer User',
                'password'          => Hash::make('password'),
                'email_verified_at' => now(),
            ]
        );

        if (method_exists($viewer, 'syncRoles')) {
            $viewer->syncRoles(['viewer']);
        }
    }
}
