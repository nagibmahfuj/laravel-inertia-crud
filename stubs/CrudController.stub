<?php

namespace {{ namespace }};

use NagibMahfuj\Crud\CrudController;

class {{ class }} extends CrudController
{
    protected function resourceConfig(): array
    {
        return [
            'model'         => \{{ modelFqcn }}::class,
            'resource_name' => '{{ resourceName }}',
            'route_prefix'  => '{{ routePrefix }}',
            'page_prefix'   => '{{ pagePrefix }}',
            'per_page'      => 10,
            'searchable'    => [{{ searchable }}],
            'actions'       => [{{ actions }}],
            'columns'       => [
{{ columns }}
            ],
            'filters' => [],
            'fields'  => [
{{ fields }}
            ],
        ];
    }
}
